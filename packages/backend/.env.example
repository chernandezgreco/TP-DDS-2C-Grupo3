# Copiar a .env y completar. El .env no se sube al repo.
SERVER_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000

# Mongo local (docker compose up mongo) o el contenedor del servidor
MONGO_URI=mongodb://localhost:27017/codigo_a_voluntad

# En producción: NODE_ENV=production (cookie Secure y trust proxy). Ver DEPLOY.md.
# URL pública del frontend para los enlaces RSS
PUBLIC_APP_URL=http://localhost:3000
# Cuota por IP y proceso. Incluye lecturas y escrituras; excluye OPTIONS y /health.
PUBLIC_RATE_LIMIT=120
PUBLIC_RATE_WINDOW_MS=60000
# Descargas de "Mis datos" (portabilidad): exitosas por cuenta y ventana en ms.
EXPORT_RATE_LIMIT=5
EXPORT_RATE_WINDOW_MS=900000
# Clave privada para administrar términos. Generar al menos 32 caracteres.
# No ponerla en REACT_APP_ ni subirla al repositorio.
ADMIN_API_KEY=

# Envío real de notificaciones por email (SMTP). En desarrollo, sin SMTP_HOST se simula.
# En producción, un canal sin configurar se devuelve como fallido; no se informa como enviado.
# Con Gmail: smtp.gmail.com, puerto 587 y una "contrasena de aplicacion". No subir credenciales al repo.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Twilio SMS / WhatsApp. Los envíos reales requieren activación explícita.
# Si TWILIO_SEND_REAL=false, desarrollo simula el envío sin imprimir el mensaje.
# En producción los canales sin habilitar figuran como fallidos, no como enviados.
TWILIO_SEND_REAL=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
# Ejemplo: whatsapp:+14155238886 (Sandbox) o el remitente aprobado de la cuenta.
TWILIO_WHATSAPP_FROM=

# LinkedIn (importar perfil y compartir logros). Sin estas variables la integración
# responde 503 y el resto de la app funciona igual. Los datos salen de la app creada en
# https://www.linkedin.com/developers. La URL de callback tiene que estar registrada en esa app.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/integraciones/linkedin/callback
# Clave de 32 bytes en Base64 para cifrar los tokens guardados.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
LINKEDIN_TOKEN_ENCRYPTION_KEY=
# Versión de la API de Posts de LinkedIn (AAAAMM).
LINKEDIN_API_VERSION=202610
