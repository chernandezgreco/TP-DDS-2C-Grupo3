# Copiar a .env y completar. El .env no se sube al repo.
SERVER_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000

# Mongo local (docker compose up mongo) o el contenedor del servidor
MONGO_URI=mongodb://localhost:27017/codigo_a_voluntad

# URL pública del frontend para los enlaces RSS
PUBLIC_APP_URL=http://localhost:3000
# Cuota por IP y proceso. Incluye lecturas y escrituras; excluye OPTIONS y /health.
PUBLIC_RATE_LIMIT=120
PUBLIC_RATE_WINDOW_MS=60000
# Clave privada para administrar términos. Generar al menos 32 caracteres.
# No ponerla en REACT_APP_ ni subirla al repositorio.
ADMIN_API_KEY=
